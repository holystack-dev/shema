# --- Target / flash / PSRAM (Waveshare ESP32-S3-Touch-LCD-1.85C V2) ---
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FREERTOS_HZ=1000

# --- Partition table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- FATFS long filenames (REQUIRED) ---
# The SD layout is BIBLE/<LANG>/<VERSION>, e.g. Malayalam/POC_Dramatized. Without
# LFN, readdir() returns 8.3 names (MALAYA~1) and the version scan / default-version
# match in app_ui/app_player break. UTF-8 API encoding is set explicitly because the
# FATFS default is ANSI/OEM, which would mangle any non-ASCII folder name.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# --- App main task: heavy init (display, codec, sd) needs headroom ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- Console + logs over the native USB (Type-C), like the stock firmware ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- LVGL 8.x ---
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y
CONFIG_LV_INDEV_DEF_READ_PERIOD=16
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_DEMO_BENCHMARK=n
CONFIG_LV_USE_DEMO_STRESS=n
CONFIG_LV_USE_DEMO_MUSIC=n
